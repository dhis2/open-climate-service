# Open Climate Service instance configuration.
# Replace the values below with your country before deploying.
# See docs/setup_guide.md for field descriptions.

id: sierra-leone-climate-service   # unique identifier for this instance — used as the STAC catalog id
name: Sierra Leone Climate Service   # human-readable name shown in the web UI (optional, defaults to "Open Climate Service")

extent:
  name: Sierra Leone
  bbox: [-13.5, 6.9, -10.1, 10.0]
  country_code: SLE

data_dir: ./data   # required — directory for downloaded NetCDF files and Zarr stores

# The clock. What runs on it, and what runs after a change, are steps managed through /steps
# and stored in <data_dir>/steps.json, not here (see docs/steps.md). Only one OCS process may
# enable the scheduler.
# scheduler:
#   enabled: true
#   timezone: UTC

# Named feature collections (org unit polygons, facility points) live in plugins/vectors/*.yaml
# templates, not here -- see the instance guide. A workflow step references one by id with
# {from_features: <id>} instead of embedding a FeatureCollection inline.

# The named export owns the DHIS2 mapping and connection. The job it produces carries a
# delivery manifest, so the saved result can be submitted to POST /exports/chirps-daily.
# dhis2_connections:
#   - id: national-hmis
#     url: https://hmis.example.org/dhis
#     token_env: DHIS2_IMPORT_TOKEN
# exports:
#   - id: chirps-daily
#     plugin: dhis2
#     dataset: chirps3_precipitation_daily
#     connection: national-hmis
#     aggregation: mean
#     period_type: daily
#     series:
#       - select: {}
#         data_element: BXgDHhPdFVU

# plugins_dir: ./plugins/   # optional — plugin root: dataset templates in rasters/ and vectors/, Python modules importable by dotted path
# crs: EPSG:4326             # optional — CRS for stored GeoZarr files (default: EPSG:4326); use e.g. EPSG:25833 for UTM33
# utc_offset_hours: 0        # optional — UTC offset in hours for local-day aggregation in daily_from_hourly datasets (default: 0 = UTC)
