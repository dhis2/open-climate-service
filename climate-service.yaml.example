# Open Climate Service instance configuration.
# Replace the values below with your country before deploying.
# See docs/setup_guide.md for field descriptions.

id: sierra-leone-climate-service   # unique identifier for this instance — used as the STAC catalog id
name: Sierra Leone Climate Service   # human-readable name shown in the web UI (optional, defaults to "Open Climate Service")

extent:
  name: Sierra Leone
  bbox: [-13.5, 6.9, -10.1, 10.0]
  country_code: SLE

data_dir: ./data   # required — directory for downloaded NetCDF files and Zarr stores

# Operator-managed recurring checks. Each previously ingested dataset may appear once, with its
# own cadence. Due checks enter the same native job queue; stagger times where practical.
# scheduler:
#   enabled: true
#   timezone: UTC
#   dataset_sync:
#     - dataset_id: chirps3_precipitation_daily
#       cron: "0 6 * * *"       # every day at 06:00 UTC
#       publish: true
#       max_attempts: 3
#
#     - dataset_id: era5land_temperature_monthly
#       cron: "30 6 * * *"      # check daily at 06:30 UTC
#       publish: true
#       max_attempts: 3
#
#     - dataset_id: worldpop_population_global2_100m
#       cron: "0 7 1 * *"       # first day of each month at 07:00 UTC
#       publish: true
#       max_attempts: 3

# Post to a webhook when a scheduled sync or a pipeline starts failing, and when it recovers.
# A Slack or Mattermost incoming-webhook URL works as it is. See docs/scheduled_sync.md.
# notifications:
#   webhook_url: ${OCS_WEBHOOK_URL}

# Named feature collections (org unit polygons, facility points) live in plugins/vectors/*.yaml
# templates, not here -- see the instance guide. A pipeline binds one by id with
# {from_features: <id>} instead of embedding a FeatureCollection inline.

# Automation is not configured here. A derived dataset (an anomaly, a normal) is kept current by
# the recipe in its dataset template, and a pipeline, created on the Pipelines page or through
# POST /pipelines, delivers a dataset to DHIS2 each time it updates. See
# docs/workflow_automation.md. A pipeline names its DHIS2 connection from this list:
# dhis2_connections:
#   - id: national-hmis
#     url: https://hmis.example.org/dhis
#     token_env: DHIS2_IMPORT_TOKEN

# plugins_dir: ./plugins/   # optional — plugin root: dataset templates in rasters/ and vectors/, Python modules importable by dotted path
# crs: EPSG:4326             # optional — CRS for stored GeoZarr files (default: EPSG:4326); use e.g. EPSG:25833 for UTM33
# utc_offset_hours: 0        # optional — UTC offset in hours for datasets that support local-day aggregation (default: 0); not applied yet: all built-in datasets run in UTC+0
